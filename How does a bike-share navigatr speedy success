      "source": "casual_trips = all_rides2[\n    (all_rides2[\"member_casual\"] == \"casual\")\n    & (all_rides2[\"ride_length\"] > 0)\n]\n\nstart = casual_trips[\"started_at\"]\nend = casual_trips[\"ended_at\"]\n\nrental_threshold_counts = pd.Series({\n    \"Over 1 day to 10 days\":\n        (end > start + pd.Timedelta(days=1)).sum(),\n    \"Over 10 days to 20 days\":\n        (end > start + pd.Timedelta(days=10)).sum(),\n    \"Over 20 days to 1 month\":\n        (end > start + pd.Timedelta(days=20)).sum(),\n    \"Over 1 month to 2 months\":\n        (end > start + pd.DateOffset(months=1)).sum(),\n    \"Over 2 months to 3 months\":\n        (end > start + pd.DateOffset(months=2)).sum(),\n    \"Over 3 months to 4 months\":\n        (end > start + pd.DateOffset(months=3)).sum(),\n    \"Over 4 months\":\n        (end > start + pd.DateOffset(months=4)).sum(),\n})\n\n# 用相鄰門檻的趟數相減，讓每趟只落在一個區間\nnext_count = rental_threshold_counts.shift(-1, fill_value=0)\nrange_counts = rental_threshold_counts - next_count\n\nsummary = range_counts.to_frame(name=\"Trips\")\nsummary[\"Share (%)\"] = summary[\"Trips\"] / len(casual_trips) * 100\n\ndisplay(summary.round(3))\n\nax = summary[\"Trips\"].plot(kind=\"barh\", figsize=(10, 5), color=\"steelblue\")\nax.invert_yaxis()  # 讓最短的區間排在最上面\n\n# 在每根柱子旁標出趟數和占比\nlabels = [\n    f\"{trips} ({share:.2f}%)\"\n    for trips, share in zip(summary[\"Trips\"], summary[\"Share (%)\"])\n]\nax.bar_label(ax.containers[0], labels=labels, padding=5)\n\nax.set_xlim(0, summary[\"Trips\"].max() * 1.35)\nax.set_xlabel(\"Number of casual rentals\")\nax.set_title(\"Casual Rentals Over 24 Hours by Duration Range\")\nplt.tight_layout()\nplt.show()",
